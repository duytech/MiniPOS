POSTGRES_DB=pos
POSTGRES_USER=pos
# Required: set your own password before docker compose up; compose stops while it is blank. To make one:
# openssl rand -hex 24 (hex is safe in the connection string, where a ; would break it).
POSTGRES_PASSWORD=

# Image tag that docker compose --profile app pulls from GHCR: latest, or sha-<short commit> to pin a build.
POS_TAG=latest
