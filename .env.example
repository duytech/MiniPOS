POSTGRES_DB=pos
POSTGRES_USER=pos
# Required: set your own password before docker compose up; compose stops while it is blank.
# Letters and digits only: it goes into the connection string unescaped, where a ; would end its value.
# To make one: openssl rand -hex 24
POSTGRES_PASSWORD=

# Image tag that docker compose --profile app pulls from GHCR: latest, or sha-<short commit> to pin a build.
POS_TAG=latest
