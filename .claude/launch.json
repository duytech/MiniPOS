{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Pos.Api", "--launch-profile", "http"],
      "port": 5191
    },
    {
      "name": "api-e2e",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "tests/e2e/start-api.ps1"],
      "port": 5191,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "start"],
      "port": 4200
    }
  ]
}
