@Pos.Api_HostAddress = http://localhost:5191

### Create a menu item
# @name menuItem
POST {{Pos.Api_HostAddress}}/api/menu-items
Content-Type: application/json

{ "name": "Pho", "price": 7.70 }

### Create an order
# @name order
POST {{Pos.Api_HostAddress}}/api/orders

### Add an item to the order
# @name addItem
POST {{Pos.Api_HostAddress}}/api/orders/{{order.response.body.$.id}}/items
Content-Type: application/json

{ "menuItemId": "{{menuItem.response.body.$.id}}", "quantity": 2, "notes": "no onions" }

### Discount: a percentage of the subtotal ({ "rate": 15 }) or a fixed amount ({ "amount": 2.50 })
PUT {{Pos.Api_HostAddress}}/api/orders/{{order.response.body.$.id}}/discount
Content-Type: application/json

{ "rate": 15 }

### Remove the discount
DELETE {{Pos.Api_HostAddress}}/api/orders/{{order.response.body.$.id}}/discount

### Tip as a percentage of the subtotal after discount
PUT {{Pos.Api_HostAddress}}/api/orders/{{order.response.body.$.id}}/tip
Content-Type: application/json

{ "rate": 18 }

### Remove the line added above (422 while a fixed discount is more than the new subtotal)
DELETE {{Pos.Api_HostAddress}}/api/orders/{{order.response.body.$.id}}/lines/{{addItem.response.body.$.lines[0].id}}

### Remove the tip
DELETE {{Pos.Api_HostAddress}}/api/orders/{{order.response.body.$.id}}/tip

### Pay by card (adds the card surcharge) or "Cash"
PUT {{Pos.Api_HostAddress}}/api/orders/{{order.response.body.$.id}}/payment-method
Content-Type: application/json

{ "paymentMethod": "Card" }

### List open orders containing "pho" (or order number), newest first
GET {{Pos.Api_HostAddress}}/api/orders?search=pho&status=Open&page=1&pageSize=20
Accept: application/json

### Get the order with its totals
GET {{Pos.Api_HostAddress}}/api/orders/{{order.response.body.$.id}}
Accept: application/json

### Pay the whole order with its payment method (closes it; later changes are 422)
POST {{Pos.Api_HostAddress}}/api/orders/{{order.response.body.$.id}}/pay

### Cancel an open order (422 once it is paid or cancelled)
POST {{Pos.Api_HostAddress}}/api/orders/{{order.response.body.$.id}}/cancel

###
