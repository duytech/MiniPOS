@Pos.Api_HostAddress = http://localhost:5191

### List menu items (4 are seeded by the initial migration)
GET {{Pos.Api_HostAddress}}/api/menu-items
Accept: application/json

### Create an order
# @name createOrder
POST {{Pos.Api_HostAddress}}/api/orders
Accept: application/json

### Add an item (Espresso x2)
POST {{Pos.Api_HostAddress}}/api/orders/{{createOrder.response.body.$.id}}/items
Content-Type: application/json

{
  "menuItemId": "11111111-1111-1111-1111-000000000001",
  "quantity": 2
}

### Get the order
GET {{Pos.Api_HostAddress}}/api/orders/{{createOrder.response.body.$.id}}
Accept: application/json

### Get the order total
GET {{Pos.Api_HostAddress}}/api/orders/{{createOrder.response.body.$.id}}/total
Accept: application/json

### List orders (newest first)
GET {{Pos.Api_HostAddress}}/api/orders
Accept: application/json

### List open orders containing "espresso"
GET {{Pos.Api_HostAddress}}/api/orders?status=Open&search=espresso
Accept: application/json

###
