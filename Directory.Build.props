<Project>

  <!-- Build-time verifiers for every project: any compiler, analyzer or code-style warning fails the build. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 (unnecessary using) only runs on build when XML docs are generated. Missing docs are not enforced. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Sonar for one rule only: S3776 Cognitive Complexity. sonar.globalconfig turns every other Sonar rule off. -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="all" IncludeAssets="analyzers" />
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)sonar.globalconfig" />
  </ItemGroup>

  <!-- Code metric thresholds (CA1501/CA1502/CA1505/CA1506); only CA1505 differs from the default. -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" />
  </ItemGroup>

</Project>
