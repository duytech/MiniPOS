<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.7173973">
  <PropertyGroup>
    <StartupCommand>npm start</StartupCommand>
    <JavaScriptTestFramework>Jasmine</JavaScriptTestFramework>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist\web\browser\</BuildOutputFolder>
    <!-- Keep `dotnet build` / `dotnet test` fast: the Angular app is built with npm, not MSBuild. -->
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
  </PropertyGroup>
</Project>
