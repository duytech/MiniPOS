# SonarAnalyzer.CSharp (Directory.Build.props): every rule in Sonar's default set (Sonar Way) runs and, with
# TreatWarningsAsErrors, fails the build. S3776 Cognitive Complexity uses Sonar's default threshold (15 per method,
# 3 per property accessor). A rule is only turned off here with a one-line reason.
is_global = true

dotnet_diagnostic.S3776.severity = warning

# False positive: flags the last collection expression passed to a params array of collections (ApiClient.SplitBody).
dotnet_diagnostic.S3878.severity = none

# The owner's choice: stacked foreach loops without braces (CallScanner, MoneyTypeTests) read fine as one loop.
dotnet_diagnostic.S3973.severity = none
